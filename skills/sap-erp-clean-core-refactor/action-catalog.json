{
  "version": 1,
  "description": "Canonical ARC-1 payload examples. Runtime substitutes requiredInputs and must preserve the validated argument shape.",
  "operations": {
    "system_probe": { "tool": "SAPManage", "requiredInputs": [], "exampleArgs": { "action": "probe" } },
    "read_system": { "tool": "SAPRead", "requiredInputs": [], "exampleArgs": { "type": "SYSTEM" } },
    "inventory_package": { "tool": "SAPRead", "requiredInputs": ["name"], "exampleArgs": { "type": "DEVC", "name": "ZPKG" } },
    "exact_tadir_lookup": { "tool": "SAPSearch", "requiredInputs": ["names"], "exampleArgs": { "searchType": "tadir_lookup", "names": ["ZCL_EXAMPLE"], "source": "adt", "maxResults": 20 } },
    "read_source": { "tool": "SAPRead", "requiredInputs": ["type", "name"], "exampleArgs": { "type": "CLAS", "name": "ZCL_EXAMPLE" } },
    "read_dependencies": { "tool": "SAPContext", "requiredInputs": ["type", "name"], "exampleArgs": { "action": "deps", "type": "CLAS", "name": "ZCL_EXAMPLE", "depth": 1 } },
    "find_references": { "tool": "SAPNavigate", "requiredInputs": ["type", "name", "maxResults"], "exampleArgs": { "action": "references", "type": "CLAS", "name": "ZCL_EXAMPLE", "maxResults": 1000 } },
    "atc_assessment": { "tool": "SAPDiagnose", "requiredInputs": ["type", "name", "variant"], "exampleArgs": { "action": "atc", "type": "CLAS", "name": "ZCL_EXAMPLE", "variant": "ABAP_CLOUD_READINESS" } },
    "atc_variants": { "tool": "SAPDiagnose", "requiredInputs": [], "exampleArgs": { "action": "atc_variants", "variant": "*" } },
    "read_api_state": { "tool": "SAPRead", "requiredInputs": ["name", "objectType"], "exampleArgs": { "type": "API_STATE", "name": "ZIF_EXAMPLE", "objectType": "INTF" } },
    "quickfix_preview": { "tool": "SAPDiagnose", "requiredInputs": ["type", "name", "source", "line", "column"], "exampleArgs": { "action": "quickfix", "type": "CLAS", "name": "ZCL_EXAMPLE", "source": "CLASS zcl_example DEFINITION. ENDCLASS.", "line": 1, "column": 1 } },
    "quickfix_apply": { "tool": "SAPDiagnose", "requiredInputs": ["type", "name", "source", "line", "column", "proposalUri", "proposalUserContent"], "exampleArgs": { "action": "apply_quickfix", "type": "CLAS", "name": "ZCL_EXAMPLE", "source": "CLASS zcl_example DEFINITION. ENDCLASS.", "line": 1, "column": 1, "proposalUri": "/sap/bc/adt/quickfixes/example", "proposalUserContent": "" } },
    "lint_candidate": { "tool": "SAPLint", "requiredInputs": ["source", "name"], "exampleArgs": { "action": "lint_and_fix", "source": "REPORT zexample.", "name": "ZEXAMPLE" } },
    "format_candidate": { "tool": "SAPLint", "requiredInputs": ["source"], "exampleArgs": { "action": "format", "source": "REPORT zexample." } },
    "syntax_check": { "tool": "SAPDiagnose", "requiredInputs": ["type", "name", "source"], "exampleArgs": { "action": "syntax", "type": "CLAS", "name": "ZCL_EXAMPLE", "source": "CLASS zcl_example DEFINITION. ENDCLASS." } },
    "write_update": { "tool": "SAPWrite", "requiredInputs": ["type", "name", "source", "transport"], "exampleArgs": { "action": "update", "type": "CLAS", "name": "ZCL_EXAMPLE", "source": "CLASS zcl_example DEFINITION. ENDCLASS.", "transport": "DEVK900001" } },
    "edit_method": { "tool": "SAPWrite", "requiredInputs": ["type", "name", "method", "source", "transport"], "exampleArgs": { "action": "edit_method", "type": "CLAS", "name": "ZBP_CC_EXAMPLE", "method": "lhc_cc_example~validate_input", "source": "METHOD validate_input.\n  \" validation logic\nENDMETHOD.", "transport": "DEVK900001" } },
    "edit_unit": { "tool": "SAPWrite", "requiredInputs": ["type", "name", "unit", "source", "transport"], "exampleArgs": { "action": "edit_unit", "type": "PROG", "name": "ZEXAMPLE", "unit": "check_authority", "source": "FORM check_authority.\n  \" released authority check\nENDFORM.", "transport": "DEVK900001" } },
    "scaffold_rap_handlers": { "tool": "SAPWrite", "requiredInputs": ["type", "name", "bdefName"], "exampleArgs": { "action": "scaffold_rap_handlers", "type": "CLAS", "name": "ZBP_CC_EXAMPLE", "bdefName": "ZI_CC_EXAMPLE", "autoApply": false } },
    "create_wrapper_class": { "tool": "SAPWrite", "requiredInputs": ["name", "package", "source", "transport"], "exampleArgs": { "action": "create", "type": "CLAS", "name": "ZCL_CC_WRAPPER", "description": "Clean Core wrapper", "package": "ZCC_WRAPPERS", "transport": "DEVK900001", "source": "CLASS zcl_cc_wrapper DEFINITION PUBLIC FINAL CREATE PUBLIC. ENDCLASS. CLASS zcl_cc_wrapper IMPLEMENTATION. ENDCLASS." } },
    "batch_create_objects": { "tool": "SAPWrite", "requiredInputs": ["objects", "package", "transport"], "exampleArgs": { "action": "batch_create", "package": "ZCC_TARGET", "transport": "DEVK900001", "activateAtEnd": true, "objects": [{ "type": "CLAS", "name": "ZCL_CC_TARGET", "description": "Clean Core target", "source": "CLASS zcl_cc_target DEFINITION PUBLIC FINAL CREATE PUBLIC. ENDCLASS. CLASS zcl_cc_target IMPLEMENTATION. ENDCLASS." }] } },
    "activate_object": { "tool": "SAPActivate", "requiredInputs": ["type", "name"], "exampleArgs": { "action": "activate", "type": "CLAS", "name": "ZCL_EXAMPLE" } },
    "activate_batch": { "tool": "SAPActivate", "requiredInputs": ["objects"], "exampleArgs": { "action": "activate", "objects": [{ "type": "CLAS", "name": "ZCL_EXAMPLE" }] } },
    "publish_service_binding": { "tool": "SAPActivate", "requiredInputs": ["name"], "exampleArgs": { "action": "publish_srvb", "name": "ZUI_EXAMPLE_O4", "service_type": "odatav4", "version": "0001" } },
    "run_unit_tests": { "tool": "SAPDiagnose", "requiredInputs": ["type", "name"], "exampleArgs": { "action": "unittest", "type": "CLAS", "name": "ZCL_EXAMPLE", "coverage": true } },
    "read_diff": { "tool": "SAPRead", "requiredInputs": ["type", "name", "from", "to"], "exampleArgs": { "action": "diff", "type": "CLAS", "name": "ZCL_EXAMPLE", "from": "active", "to": "inactive" } },
    "release_api": { "tool": "SAPManage", "requiredInputs": ["name", "objectType", "contract", "transport"], "exampleArgs": { "action": "set_api_state", "name": "ZIF_EXAMPLE", "objectType": "INTF", "apiState": "RELEASED", "contract": "C1", "transport": "DEVK900001" } },
    "create_wrapper_package": { "tool": "SAPManage", "requiredInputs": ["name", "description", "superPackage", "softwareComponent", "transport"], "exampleArgs": { "action": "create_package", "name": "ZCC_WRAPPERS", "description": "Clean Core wrappers", "superPackage": "ZCC", "softwareComponent": "HOME", "transport": "DEVK900001", "recordChanges": true } },
    "read_governance_document": { "tool": "SAPRead", "requiredInputs": ["name"], "exampleArgs": { "type": "SKTD", "name": "ZCC_WRAPPERS" } },
    "write_governance_document": { "tool": "SAPWrite", "requiredInputs": ["name", "package", "source", "transport", "refObjectType", "refObjectName"], "exampleArgs": { "action": "create", "type": "SKTD", "name": "ZCC_WRAPPERS", "description": "Clean Core decision", "package": "ZCC_DOC", "transport": "DEVK900001", "refObjectType": "DEVC/K", "refObjectName": "ZCC_WRAPPERS", "source": "# Clean Core decision\n\nApproved architecture and lifecycle." } },
    "delete_object": { "tool": "SAPWrite", "requiredInputs": ["type", "name", "transport"], "exampleArgs": { "action": "delete", "type": "CLAS", "name": "ZCL_UNUSED", "transport": "DEVK900001" } },
    "transport_check": { "tool": "SAPTransport", "requiredInputs": ["type", "name", "package"], "exampleArgs": { "action": "check", "type": "CLAS", "name": "ZCL_EXAMPLE", "package": "ZPKG" } },
    "transport_create": { "tool": "SAPTransport", "requiredInputs": ["package", "description"], "exampleArgs": { "action": "create", "package": "ZPKG", "description": "Clean Core remediation" } },
    "transport_release": { "tool": "SAPTransport", "requiredInputs": ["id"], "exampleArgs": { "action": "release_recursive", "id": "DEVK900001" } }
  }
}
